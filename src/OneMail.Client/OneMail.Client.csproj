<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>SMTP, IMAP and POP3 clients and SASL for .NET, over a public raw protocol layer.</Description>
    <PackageTags>$(PackageTags);smtp;imap;pop3;sasl</PackageTags>
    <!-- This package's own readme replaces the shared one; it is stamped with the release tag like the shared one. -->
    <PackageReadmeSource>$(MSBuildProjectDirectory)/PACKAGE.md</PackageReadmeSource>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

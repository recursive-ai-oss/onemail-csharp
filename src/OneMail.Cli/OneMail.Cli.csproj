<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>The onemail command-line tool: inspect, convert, recover and export email files and stores.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>onemail</ToolCommandName>
    <!-- A tool is not a library: nothing references it, so API validation and trimming do not apply to the package. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

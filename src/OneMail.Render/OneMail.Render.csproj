<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Renders an email message to a tagged PDF or PNG pages in one call, on OneRender. Native platforms only (not browser WebAssembly).</Description>
    <PackageTags>$(PackageTags);pdf;png;render</PackageTags>
  </PropertyGroup>

  <ItemGroup Label="This package's own readme replaces the shared one">
    <None Remove="../../PACKAGE.md" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneMail/OneMail.csproj" />
    <PackageReference Include="RecursiveAI.OneRender" />
    <PackageReference Include="RecursiveAI.OneRender.Pdf" />
    <PackageReference Include="RecursiveAI.OneRender.Image" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not packed until it has content: an empty package would only reserve the name. -->
    <IsPackable>false</IsPackable>
    <Description>Renders an email message to PDF or an image in one call, on OneRender.</Description>
    <PackageTags>$(PackageTags);pdf;png;render</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneMail/OneMail.csproj" />
    <PackageReference Include="RecursiveAI.OneRender" />
    <PackageReference Include="RecursiveAI.OneRender.Pdf" />
    <PackageReference Include="RecursiveAI.OneRender.Image" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Mail cryptography for .NET: S/MIME (RFC 8551) signing, verification, encryption and decryption on OneCrypto's CMS, and OpenPGP mail (PGP/MIME per RFC 3156, inline PGP, Autocrypt headers) on OneCrypto's OpenPGP messages, all with structured results; DKIM and ARC signing and verification (RSA and Ed25519) with a DNS TXT client. Native platforms only (not browser WebAssembly).</Description>
    <PackageTags>$(PackageTags);smime;cms;openpgp;pgp;dkim;arc;dns</PackageTags>
    <!-- This package's own readme replaces the shared one; it is stamped with the release tag like the shared one. -->
    <PackageReadmeSource>$(MSBuildProjectDirectory)/PACKAGE.md</PackageReadmeSource>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneMail/OneMail.csproj" />
    <PackageReference Include="RecursiveAI.OneCrypto" />
    <PackageReference Include="RecursiveAI.OneCrypto.OpenPgp" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Mail authentication signatures for .NET: DKIM and ARC signing and verification (RSA and Ed25519) with a DNS TXT client. Native platforms only (not browser WebAssembly).</Description>
    <PackageTags>$(PackageTags);dkim;arc;dns</PackageTags>
    <!-- This package's own readme replaces the shared one; it is stamped with the release tag like the shared one. -->
    <PackageReadmeSource>$(MSBuildProjectDirectory)/PACKAGE.md</PackageReadmeSource>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OneMail/OneMail.csproj" />
    <PackageReference Include="RecursiveAI.OneCrypto" />
  </ItemGroup>

</Project>

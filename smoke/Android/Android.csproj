<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(PackagePrefix).OneMail.AndroidSmoke</AssemblyName>
    <RootNamespace>$(PackagePrefix).OneMail.AndroidSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>ai.recursive.onemail.smoke</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- The emulator on a x64 host; pass -p:RuntimeIdentifier=android-arm64 for a device. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-x64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Release trims whole assemblies, as a consumer's app would. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- The libraries use no globalization data beyond invariant. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <Import Project="../Mobile.props" />

</Project>

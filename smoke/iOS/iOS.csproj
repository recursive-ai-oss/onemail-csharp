<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(PackagePrefix).OneMail.IosSmoke</AssemblyName>
    <RootNamespace>$(PackagePrefix).OneMail.IosSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>ai.recursive.onemail.smoke</ApplicationId>
    <!-- The simulator on an Apple-silicon host; pass -p:RuntimeIdentifier=ios-arm64 for a device. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">iossimulator-arm64</RuntimeIdentifier>
    <!-- Release trims whole assemblies, as a consumer's app would. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- With ahead-of-time compilation only, opening any file failed on the simulator with "Attempting to JIT compile ... while running in
         aot-only mode" (the constructor call behind SafeFileHandle's marshaller). The interpreter runs what was not compiled. -->
    <UseInterpreter>true</UseInterpreter>
    <!-- The shared checks bring their own Main for the console smoke; the app's entry point is ours. -->
    <StartupObject>RecursiveAI.OneMail.IosSmoke.AppMain</StartupObject>
  </PropertyGroup>

  <Import Project="../Mobile.props" />

</Project>

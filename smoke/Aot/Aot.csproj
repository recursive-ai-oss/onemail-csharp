<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(PackagePrefix).OneMail.AotSmoke</AssemblyName>
    <RootNamespace>$(PackagePrefix).OneMail.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Apple's static libraries carry clang module debug info whose module cache doesn't exist on a fresh machine, so
         the macOS linker warns about every missing .pcm and -warnaserror fails the publish. The smoke app needs no native
         debug info: the linker drops it (-S) and no dSYM is made from the stripped binary. -->
    <StripSymbols Condition="$([MSBuild]::IsOSPlatform('OSX'))">false</StripSymbols>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ExtraLinkerArg Include="-S" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test-side file builder makes the node-database file the smoke reads back. -->
    <Compile Include="../../tests/OneMail.Tests/Pst/NdbTestBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Pst/LtpTestBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Pst/PstFixtureBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Pst/PstFixtures.cs" />
    <!-- The same for the compound-file builder that makes the MSG the smoke reads back. -->
    <Compile Include="../../tests/OneMail.Tests/Stores/DbxTestBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Msg/MsgTestBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Msg/MsgFixtures.cs" />
    <Compile Include="../../tests/OneMail.Tests/Msg/MsgModelComparer.cs" />
    <Compile Include="../../tests/OneMail.Tests/Tnef/TnefTestBuilder.cs" />
    <!-- The browser smoke's Outlook checks; the NativeAOT smoke runs the TNEF-in-MIME one. -->
    <Compile Include="../Wasm/OutlookChecks.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMail.Calendar/OneMail.Calendar.csproj" />
    <ProjectReference Include="../../src/OneMail/OneMail.csproj" />
    <ProjectReference Include="../../src/OneMail.Client/OneMail.Client.csproj" />
    <ProjectReference Include="../../src/OneMail.Cryptography/OneMail.Cryptography.csproj" />
    <ProjectReference Include="../../src/OneMail.Render/OneMail.Render.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- BenchmarkDotNet finds the project to build per benchmark by the assembly name, so it matches the project file name. -->
    <AssemblyName>OneMail.Benchmarks</AssemblyName>
    <RootNamespace>RecursiveAI.OneMail.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1822;CA1002;CA1819</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Collections.Generic" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- The comparator for the MIME rows. It is run as a released binary and appears nowhere under src/. -->
    <PackageReference Include="MimeKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(PackagePrefix).OneMail.Fuzz</AssemblyName>
    <RootNamespace>$(PackagePrefix).OneMail.Fuzz</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMail.Calendar/OneMail.Calendar.csproj" />
    <!-- The test-side file builder makes the valid base files the patch lists are applied to. -->
    <Compile Include="../../tests/OneMail.Tests/Pst/NdbTestBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Pst/LtpTestBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Pst/PstFixtureBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Pst/PstFixtures.cs" />
    <Compile Include="../../tests/OneMail.Tests/Msg/MsgTestBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Msg/MsgFixtures.cs" />
    <Compile Include="../../tests/OneMail.Tests/Msg/MsgModelComparer.cs" />
    <Compile Include="../../tests/OneMail.Tests/Tnef/TnefTestBuilder.cs" />
    <Compile Include="../../tests/OneMail.Tests/Stores/DbxTestBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMail/OneMail.csproj" />
    <ProjectReference Include="../../src/OneMail.Client/OneMail.Client.csproj" />
    <ProjectReference Include="../../src/OneMail.Render/OneMail.Render.csproj" />
    <ProjectReference Include="../../src/OneMail.Cryptography/OneMail.Cryptography.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the differential corpus through OneMail's text layer. A tool project: nothing in src/ references it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>OneMailTextOracle</AssemblyName>
    <RootNamespace>OneMailTextOracle</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

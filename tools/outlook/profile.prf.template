; Profile with one Unicode PST store (the default store) and one inert local POP3 account. The account exists only because Outlook
; refuses to start on a profile with no mail account (it shows the account wizard); it points at a closed local port and has no credentials.
; %PROFILE%, %PST% are replaced by make-profile.ps1.
[General]
Custom=1
ProfileName=%PROFILE%
DefaultProfile=No
OverwriteProfile=Yes
ModifyDefaultProfileIfPresent=FALSE

[Service List]
Service1=Unicode Personal Folders
Service2=Outlook Address Book

[Service1]
UniqueService=No
Name=OneMailOracle
PathToPersonalFolders=%PST%
EncryptionType=0x80000000
DefaultStore=Yes

[Service2]
UniqueService=Yes

[Internet Account List]
Account1=I_Mail

[I_Mail]
AccountType=POP3
AccountName=OneMailOracle
DisplayName=OneMail Oracle
EmailAddress=oracle@example.invalid
POP3Server=127.0.0.1
POP3UserName=oracle
POP3Port=1
SMTPServer=127.0.0.1
SMTPPort=1
LeaveOnServer=1
ConnectionType=1

[Unicode Personal Folders]
ServiceName=MSUPST MS
Name=PT_UNICODE,0x3001
PathToPersonalFolders=PT_STRING8,0x6700
RememberPassword=PT_BOOLEAN,0x6701
EncryptionType=PT_LONG,0x6702
Password=PT_STRING8,0x6703

[Outlook Address Book]
ServiceName=CONTAB

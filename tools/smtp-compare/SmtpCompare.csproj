<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sends the same messages with this library and with the released MailKit package (run as a black box) to one server and prints
       wall time and allocations. Indicative only; a tool, never referenced from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SmtpCompare</AssemblyName>
    <RootNamespace>OneMail.Tools.SmtpCompare</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1303;CA1062;CA2007;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <ProjectReference Include="../../src/OneMail/OneMail.csproj" />
    <ProjectReference Include="../../src/OneMail.Client/OneMail.Client.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dumps what OneMail reads from MSG files, for the comparison with other readers, and checks that the property streams
       re-encode to the original bytes. A tool project: nothing in src/ references it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>MsgTool</AssemblyName>
    <RootNamespace>MsgTool</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);ONEARCHIVE001;ONECOMPRESS001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test-side file builder makes the generated fixtures (the gen command). -->
    <Compile Include="../../../tests/OneMail.Tests/Msg/MsgTestBuilder.cs" />
    <Compile Include="../../../tests/OneMail.Tests/Msg/MsgFixtures.cs" />
    <ProjectReference Include="../../../src/OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

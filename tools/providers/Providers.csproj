<Project Sdk="Microsoft.NET.Sdk">

  <!-- Provider tools: `token` mints and refreshes OAuth tokens (BCL HttpClient only), `smoke` runs the provider smoke set
       against real mailboxes. A tool, never referenced from src/. Credentials come from the environment only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Providers</AssemblyName>
    <RootNamespace>OneMail.Tools.Providers</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1303;CA1062;CA2007;CA1822;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneMail/OneMail.csproj" />
    <ProjectReference Include="../../src/OneMail.Client/OneMail.Client.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Converts Outlook items to EML and back and measures what carried over, for the checks in docs/conversion.md.
       A tool project: nothing in src/ references it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>OxcMailTool</AssemblyName>
    <RootNamespace>OxcMailTool</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Prints the mailbox boundaries OneMail finds, in the format of the oracle drivers, and measures enumeration cost.
       A tool project: nothing in src/ references it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>OneMailRanges</AssemblyName>
    <RootNamespace>OneMailRanges</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

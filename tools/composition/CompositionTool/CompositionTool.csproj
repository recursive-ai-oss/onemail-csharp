<Project Sdk="Microsoft.NET.Sdk">

  <!-- Makes replies and forwards of every item of a corpus and checks them, for the checks in docs/composition.md.
       A tool project: nothing in src/ references it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>CompositionTool</AssemblyName>
    <RootNamespace>CompositionTool</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- OneArchive's compound-file reader is a preview API; this is its documented opt-in. -->
    <NoWarn>$(NoWarn);ONEARCHIVE001;ONECOMPRESS001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

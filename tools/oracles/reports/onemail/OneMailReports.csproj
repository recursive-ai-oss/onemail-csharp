<Project Sdk="Microsoft.NET.Sdk">

  <!-- OneMail's driver for the report differential (tools/oracles/reports/README.md): prints the report, authentication and
       MHTML views of each message in the shared dump form. A tool, never packed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OneMailReports</AssemblyName>
    <RootNamespace>OneMail.Oracles.OneMailReports</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

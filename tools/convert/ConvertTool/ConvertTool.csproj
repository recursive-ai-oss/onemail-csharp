<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the store-to-store conversions over corpora and checks the result by reading it back, for docs/fidelity.md.
       A tool project: nothing in src/ references it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>ConvertTool</AssemblyName>
    <RootNamespace>ConvertTool</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OneMail/OneMail.csproj" />
  </ItemGroup>

</Project>

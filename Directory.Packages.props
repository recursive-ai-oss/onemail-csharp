<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Family libraries (shipped dependencies)">
    <PackageVersion Include="RecursiveAI.OneArchive" Version="1.1.0" />
    <PackageVersion Include="RecursiveAI.OneHtml" Version="1.5.1" />
    <PackageVersion Include="RecursiveAI.OneRender" Version="1.3.1" />
    <PackageVersion Include="RecursiveAI.OneRender.Pdf" Version="1.3.1" />
    <PackageVersion Include="RecursiveAI.OneRender.Image" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup Label="Test, benchmark and fuzz projects only">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <PackageVersion Include="MimeKit" Version="4.18.2" />
    <PackageVersion Include="XstReader.Api" Version="1.0.6" />
    <PackageVersion Include="MsgReader" Version="6.2.0" />
    <PackageVersion Include="Ical.Net" Version="5.2.3" />
    <PackageVersion Include="FolkerKinzel.VCards" Version="8.2.0" />
  </ItemGroup>
</Project>
